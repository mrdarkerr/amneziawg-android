<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="org.amnezia.awg.model.ObservableTunnel" />
        <import type="org.amnezia.awg.model.ObservableTunnel.ConnectionStatus" />
        <variable name="collection" type="org.amnezia.awg.databinding.ObservableKeyedArrayList&lt;String, ObservableTunnel&gt;" />
        <variable name="key" type="String" />
        <variable name="item" type="org.amnezia.awg.model.ObservableTunnel" />
        <variable name="fragment" type="org.amnezia.awg.fragment.TunnelListFragment" />
    </data>

    <org.amnezia.awg.widget.MultiselectableRelativeLayout
        android:id="@+id/tunnel_list_item"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/super_ip_config_card"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/tunnel_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/super_ip_details"
            android:padding="10dp"
            android:src="@drawable/ic_action_more_vert"
            app:tint="@color/super_ip_text_secondary" />

        <TextView
            android:id="@+id/tunnel_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tunnel_more"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{key}"
            android:textColor="@color/super_ip_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Turkey 2" />

        <TextView
            android:id="@+id/tunnel_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:text="@{item.connectionStatus == ConnectionStatus.CONNECTED ? @string/tunnel_status_connected : (item.connectionStatus == ConnectionStatus.CONNECTING ? @string/tunnel_status_connecting : @string/super_ip_ready)}"
            android:textColor="@{item.connectionStatus == ConnectionStatus.CONNECTED ? @color/tunnel_status_connected : @color/super_ip_text_secondary}"
            android:textSize="12sp"
            tools:text="Ready" />
    </org.amnezia.awg.widget.MultiselectableRelativeLayout>
</layout>
